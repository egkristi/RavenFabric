[18.85, "o", "  \"commands\": {\r\n    \"allow\": [\"^hostname\", \"^uname\", \"^uptime\", \"^cat /etc/\"],\r\n    \"deny\": [\".*rm.*-rf.*\", \".*curl.*\", \".*wget.*\"]\r\n  },\r\n  \"mode\": \"deny-by-default\"\r\n\u001b[33m}\u001b[0m\r\n\r\n"]
[20.8, "o", "\u001b[0;90m  # Web dashboard available at http://$HOST:8080\u001b[0m\r\n"]
[21.3, "o", "  \u001b[32m✓\u001b[0m Dashboard: real-time agent metrics, activity feed\r\n"]
[21.5, "o", "  \u001b[32m✓\u001b[0m Security headers: X-Frame-Options, X-Content-Type-Options\r\n"]
[21.7, "o", "  \u001b[32m✓\u001b[0m Request size: 1 MB limit, bearer token auth\r\n\r\n"]
