[5.5, "o", "\u001b[33m  Available tools:\u001b[0m\r\n"]
[5.6, "o", "    rf_exec              Execute commands (policy-checked)\r\n"]
[5.7, "o", "    rf_query_policy      Dry-run: check if command is allowed\r\n"]
[5.8, "o", "    rf_file_read         Read files (path-policy enforced)\r\n"]
