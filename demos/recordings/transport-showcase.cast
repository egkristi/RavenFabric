[27.0, "o", "\u001b[1;33m  ┌──────────────────────────────────────────────────────┐\u001b[0m\r\n"]
[27.05, "o", "\u001b[1;33m  │  Transport        Protocol   Latency    Use Case    │\u001b[0m\r\n"]
[27.1, "o", "\u001b[1;33m  ├──────────────────────────────────────────────────────┤\u001b[0m\r\n"]
[27.15, "o", "\u001b[1;33m  │  WebSocket        TCP        ~1.2 ms    Default     │\u001b[0m\r\n"]
[27.2, "o", "\u001b[1;33m  │  QUIC             UDP        ~0.8 ms    Mobile      │\u001b[0m\r\n"]
[27.25, "o", "\u001b[1;33m  │  UNIX Socket      IPC        ~0.1 ms    Same-host   │\u001b[0m\r\n"]
[27.3, "o", "\u001b[1;33m  │  Stdio Pipe       Process    ~0.05ms    MCP server  │\u001b[0m\r\n"]
[27.35, "o", "\u001b[1;33m  │  Memory           In-proc    ~0.01ms    Testing     │\u001b[0m\r\n"]
[27.4, "o", "\u001b[1;33m  └──────────────────────────────────────────────────────┘\u001b[0m\r\n\r\n"]
[29.4, "o", "\r\n\u001b[1;36m  5 transports · 1 protocol · Identical encryption\u001b[0m\r\n"]
[29.45, "o", "  ────────────────────────────────────────────────────────────\r\n\r\n"]
