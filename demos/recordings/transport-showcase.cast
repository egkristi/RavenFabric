{"version": 2, "width": 100, "height": 28, "timestamp": 1778446800, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "RavenFabric — Transport Showcase"}
[0.15, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.16, "o", "\r\n\u001b[1;36m  RavenFabric — Transport Showcase\u001b[0m\r\n"]
[0.17, "o", "  ────────────────────────────────────────────────────────────\r\n\r\n"]
[1.2, "o", "\u001b[0;90m  # Same Noise XX encryption over 5 fundamentally different transports\u001b[0m\r\n"]
[1.7, "o", "\u001b[0;90m  # The transport is just a byte pipe — security lives above it\u001b[0m\r\n"]
[3.2, "o", "\u001b[0;90m  # 1. WebSocket (TCP) — default relay transport\u001b[0m\r\n"]
[3.7, "o", "\u001b[1;32m$\u001b[0m "]
