[5.2, "o", "running 1 test\r\n"]
[5.8, "o", "\u001b[32mtest websocket_transport ... ok\u001b[0m\r\n"]
[6.0, "o", "  \u001b[32m✓ WebSocket: Noise XX handshake + SecureChannel + RPC over TCP\u001b[0m\r\n"]
[6.2, "o", "    Latency: ~1.2ms | Encrypted: ChaCha20-Poly1305 | Auth: Curve25519\r\n\r\n"]
