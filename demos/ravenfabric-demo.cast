[236.977019, "o", "\r\n\u001b[1;36m  15. Transport Diversity — Any Channel Works\u001b[0m\r\n"]
[236.9777, "o", "  ───────────────────────────────────────────────────────\r\n\r\n"]
[238.479058, "o", "\u001b[0;90m  # RavenFabric runs over any byte-moving channel:\u001b[0m\r\n"]
[238.980198, "o", "\r\n\u001b[0;90m    • WebSocket  (TCP, default)\u001b[0m\r\n\u001b[0;90m    • QUIC       (UDP, low-latency)\u001b[0m\r\n\u001b[0;90m    • UNIX socket (IPC, local)\u001b[0m\r\n"]
[238.980271, "o", "\u001b[0;90m    • Stdio pipe  (parent-child process)\u001b[0m\r\n\u001b[0;90m    • Memory     (in-process, testing)\u001b[0m\r\n\u001b[0;90m    • LoRa, BLE, AX.25, satellite, mixnet\u001b[0m\r\n\r\n"]
[240.981902, "o", "\r\n\u001b[1;36m  16. Run Anywhere\u001b[0m\r\n"]
[240.982683, "o", "  ───────────────────────────────────────────────────────\r\n\r\n"]
[242.483881, "o", "\u001b[0;90m  # One binary, every platform:\u001b[0m\r\n"]
[242.985103, "o", "\r\n\u001b[0;90m    • Linux (x86_64, arm64, armv7, riscv64)\u001b[0m\r\n\u001b[0;90m    • macOS (Intel + Apple Silicon)\u001b[0m\r\n\u001b[0;90m    • Windows (x86_64)\u001b[0m\r\n\u001b[0;90m    • FreeBSD, Android, iOS\u001b[0m\r\n\u001b[0;90m    • WASM/WASI, OpenWrt, ESP32\u001b[0m\r\n\u001b[0;90m    • Static musl — no libc dependency\u001b[0m\r\n\r\n"]
