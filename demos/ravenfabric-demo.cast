[271.032829, "o", "\r\n"]
[271.335105, "o", "\u001b[0;33m  (CLI fails over to the next relay on connection or handshake failure)\u001b[0m\r\n\r\n"]
[272.338053, "o", "\u001b[0;90m  # Agents configure multiple relays in raven.toml for the same failover:\u001b[0m\r\n"]
[272.839711, "o", "\u001b[0;90m  [[transport.relay_clusters]]\u001b[0m\r\n\u001b[0;90m  urls = [\"wss://relay-eu/meet\", \"wss://relay-us/meet\", \"wss://relay-ap/meet\"]\u001b[0m\r\n\r\n"]
[274.841893, "o", "\r\n\u001b[1;36m  20. Cleanup\u001b[0m\r\n"]
[274.843682, "o", "  ───────────────────────────────────────────────────────\r\n\r\n"]
[276.347038, "o", "\u001b[0;90m  # Stop dev mode\u001b[0m\r\n"]
[276.951825, "o", "\u001b[0;32m  ✓ dev mode stopped\u001b[0m\r\n\r\n"]
[277.953297, "o", "\r\n"]
[277.954145, "o", "  ═══════════════════════════════════════════════════════\r\n\r\n\u001b[1;36m  RavenFabric v1.0.0-rc.12\u001b[0m — Security-first distributed execution\r\n\r\n"]
[277.954225, "o", "\u001b[0;37m  ✓ Noise XX mutual authentication (no TLS, no certificates)\u001b[0m\r\n\u001b[0;37m  ✓ Deny-by-default policy engine\u001b[0m\r\n\u001b[0;37m  ✓ Structured audit logging (every action recorded)\u001b[0m\r\n\u001b[0;37m  ✓ End-to-end encryption (relay never decrypts)\u001b[0m\r\n\u001b[0;37m  ✓ Single static binary, zero dependencies\u001b[0m\r\n\u001b[0;37m  ✓ Runs everywhere — Linux, macOS, Windows, IoT\u001b[0m\r\n\u001b[0;37m  ✓ Any transport — WebSocket, QUIC, LoRa, BLE, satellite\u001b[0m\r\n\u001b[0;37m  ✓ AI-ready — MCP server for agent integration\u001b[0m\r\n"]
[277.954289, "o", "\u001b[0;37m  ✓ Cross-platform compatibility mode\u001b[0m\r\n\u001b[0;37m  ✓ Relay high availability — multi-relay failover\u001b[0m\r\n\r\n\u001b[0;37m  github.com/egkristi/RavenFabric\u001b[0m\r\n\r\n"]
