[Unit]
Description=RavenFabric MCP Server — AI agent integration
Documentation=https://ravenfabric.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rf-mcp-server \
    --policy /etc/ravenfabric/policy.yaml \
    --audit /var/log/ravenfabric/mcp-audit.jsonl \
    --http-listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5

# Environment
Environment=RF_LOG_LEVEL=info

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/log/ravenfabric
ReadOnlyPaths=/etc/ravenfabric

# Resource limits
LimitNOFILE=65536
MemoryMax=256M

[Install]
WantedBy=multi-user.target
