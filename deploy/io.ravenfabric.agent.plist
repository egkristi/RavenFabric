<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.ravenfabric.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/rf-agent</string>
        <string>--config</string>
        <string>/etc/ravenfabric/raven.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/ravenfabric/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ravenfabric/agent.err</string>
    <key>WorkingDirectory</key>
    <string>/var/lib/ravenfabric</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
</dict>
</plist>
